<Window x:Class="CSVEditor.View.GitPushWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:CSVEditor.View"
        xmlns:p="clr-namespace:CSVEditor.Core.Properties;assembly=CSVEditor.Core"
        mc:Ignorable="d"
        Title="{x:Static p:Resources.GitPushWindowTitle}" Height="auto" Width="auto"
        Icon="Resources/Icons/github.ico"
        SizeToContent="WidthAndHeight">
    
    <Border Style="{StaticResource BaseBorderStyle}"
            Background="{DynamicResource LightColorResource}"
            Margin="20,0,20,15">
        <Grid Margin="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"></RowDefinition>
                <RowDefinition Height="Auto"></RowDefinition>
                <RowDefinition Height="Auto"></RowDefinition>
                <RowDefinition Height="Auto"></RowDefinition>
                <RowDefinition Height="Auto"></RowDefinition>
                <RowDefinition Height="Auto"></RowDefinition>
            </Grid.RowDefinitions>

            <!-- Section 0: Git Status -->
            <TextBlock Text="{x:Static p:Resources.GitStatusText}"
                       Grid.Row="0"
                       Style="{StaticResource BigTextBlockStyle}"
                       Margin="10,0,0,0">
            </TextBlock>
            <TextBox Text="{Binding GitStatus, Mode=OneWay}"
                     Grid.Row="1"
                     Height="100"
                     Width="400">
            </TextBox>
            <!-- Section 1: Commit Message -->
            <TextBlock Text="{x:Static p:Resources.CommitMessageText}"
                       Grid.Row="2"
                       Style="{StaticResource BigTextBlockStyle}"
                       Margin="10,0,0,0">
            </TextBlock>
            <TextBox Text="{Binding GitOptions.CommitMessage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     Grid.Row="3"
                     Height="100"
                     Width="400">
            </TextBox>
            <!-- Section 2: Execution -->
            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,10">
                
                
                <Button Style="{StaticResource AcceptButtonStyle}"
                        Content="{x:Static p:Resources.GitPushButtonText}"
                        Click="PushButton_OnClick"
                        Margin="30,0,10,0"
                        Width="100"
                        >
                    <Button.Resources>
                        <Style TargetType="Border" BasedOn="{StaticResource RoundBordersForButtonStyle}"/>
                    </Button.Resources>
                </Button>
                <Button Style="{StaticResource CancelButtonStyle}"
                        Content="{x:Static p:Resources.CancelText}"
                        Click="CancelButton_OnClick"
                        Margin="10,0,30,0"
                        Width="100"
                        >
                    <Button.Resources>
                        <Style TargetType="Border" BasedOn="{StaticResource RoundBordersForButtonStyle}"/>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>